model AssetAssignment {
  id           String    @id @default(uuid())
  assetId      String
  userId       String
  assignedDate DateTime  @default(now())
  returnedDate DateTime?
  condition    String? // GOOD, FAIR, POOR

  asset Asset @relation(fields: [assetId], references: [id])
  user  User  @relation("AssetsAssigned", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model SystemLicense {
  id                   String    @id @default(cuid())
  licenseKey           String    @db.Text // The base64 payload + signature
  schoolName           String
  tier                 String    @default("BASIC") // BASIC, PREMIUM, ENTERPRISE
  billingFrequency     String    @default("PER_TERM") // PER_TERM, PER_SESSION
  discountPercent      Float     @default(0.0)        // e.g. 5.0 to 8.0 for annual
  currentTermId        String?
  sessionId            String?
  nextRenewalDate      DateTime?
  startingStudentCount Int?      // Snapshot at term start
  expiresAt            DateTime
  maxStudents          Int       @default(500)
  status               String    @default("ACTIVE") // ACTIVE, EXPIRED, SUSPENDED
  lastValidatedAt      DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}


