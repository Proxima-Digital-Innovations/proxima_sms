// ==============================================================================
// GRADUATION & DEGREE VERIFICATION
// ==============================================================================

model GraduationClearance {
  id                      String         @id @default(uuid())
  studentId               String         @unique
  student                 StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession         String         // e.g. "2025/2026"
  bursaryCleared          Boolean        @default(false)
  bursaryNote             String?
  bursaryClearedAt        DateTime?
  libraryCleared          Boolean        @default(false)
  libraryNote             String?
  libraryClearedAt        DateTime?
  departmentCleared       Boolean        @default(false)
  departmentNote          String?
  departmentClearedAt     DateTime?
  facultyCleared          Boolean        @default(false)
  facultyNote             String?
  facultyClearedAt        DateTime?
  studentAffairsCleared    Boolean        @default(false)
