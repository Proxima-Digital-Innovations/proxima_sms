  guardianName         String?
  guardianEmail        String?
  guardianPhone        String?
  guardianRelationship String?                      @default("Parent / Guardian")
  registrations        SemesterRegistration[]
  grades               StudentGrade[]
  candidateTokens      ExamCandidateToken[]
  academicStandings    StudentAcademicStanding[]
  clearance            GraduationClearance?
  cbtSubmissions       CbtSubmission[]
  invoices             TertiaryInvoice[]
  addDropRequests      CourseAddDropRequest[]
  assignmentSubmissions TertiaryAssignmentSubmission[]
  hostelAllocations     HostelAllocation[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
}

model StaffProfile {
  id             String                 @id @default(uuid())
  userId         String                 @unique
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffCode      String                 @unique
  departmentId   String?
  department     Department?            @relation(fields: [departmentId], references: [id])
  advisedRegs    SemesterRegistration[] @relation("AdvisorRelation")
  deanedFaculties Faculty[]              @relation("FacultyDean")
  reviewedAddDrops CourseAddDropRequest[]
  assignedCourses       CourseLecturer[]
  uploadedMaterials     TertiaryLectureMaterial[]
  assignedAssignments   TertiaryAssignment[]
  gradedSubmissions     TertiaryAssignmentSubmission[] @relation("SubmissionGrader")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model AcademicProgram {
  id                   String                @id @default(uuid())
  code                 String                @unique
  name                 String
  gradingStandard      AccreditationStandard @default(NIGERIA_NUC_5_0)
  totalCreditsRequired Int                   @default(120)
  departmentId         String?
  department           Department?           @relation(fields: [departmentId], references: [id])
  students             StudentProfile[]
  courses              Course[]
  facultyId            String?
  faculty              Faculty?               @relation(fields: [facultyId], references: [id])
  feeStructures        TertiaryFeeStructure[]
  firstChoiceApplicants AdmissionApplicant[] @relation("FirstChoiceProgram")
  secondChoiceApplicants AdmissionApplicant[] @relation("SecondChoiceProgram")
  admittedApplicants   AdmissionApplicant[] @relation("AdmittedProgram")
  cutOffs              DepartmentalCutOff[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Course {
  id              String               @id @default(uuid())
  code            String               @unique // e.g. "CSC301"
  title           String
  creditUnits     Int                  @default(3)
  level           Int                  @default(100)
  semester        Int                  @default(1)
  programId       String?
  program         AcademicProgram?     @relation(fields: [programId], references: [id])
  prerequisites   CoursePrerequisite[] @relation("CourseToPrereq")
  prerequisiteFor CoursePrerequisite[] @relation("PrereqToCourse")
  offerings       CourseOffering[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model CoursePrerequisite {
  courseId         String
  prerequisiteId   String
  minGradeRequired String  @default("D")

  course           Course  @relation("CourseToPrereq", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite     Course  @relation("PrereqToCourse", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([courseId, prerequisiteId])
}

model CourseOffering {
  id                 String                     @id @default(uuid())
  courseId           String
  course             Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicSession    String                     // e.g. "2025/2026"
  semester           Int                        // 1 or 2
  maxCapacity        Int                        @default(100)
  enrolledCount      Int                        @default(0)
  isRegistrationOpen Boolean                    @default(true)
  registeredCourses  StudentRegisteredCourse[]
  grades             StudentGrade[]
  candidateTokens    ExamCandidateToken[]
  cbtExams           CbtExam[]
  schedules          CourseSchedule[]
  addDropRequests    CourseAddDropRequest[]
  lecturers          CourseLecturer[]
  materials          TertiaryLectureMaterial[]
  assignments        TertiaryAssignment[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([courseId, academicSession, semester])
}

model SemesterRegistration {
  id                     String                    @id @default(uuid())
  studentId              String
  student                StudentProfile            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession        String
  semester               Int
  status                 RegistrationStatus        @default(DRAFT)
  totalCredits           Int                       @default(0)
  advisorId              String?
  advisor                StaffProfile?             @relation("AdvisorRelation", fields: [advisorId], references: [id])
  rejectionReason        String?                   @db.Text
  isDeanApprovedOverload Boolean                   @default(false)
  isBursaryCleared       Boolean                   @default(false)
  bursaryClearedAt       DateTime?
  bursaryReference       String?
  courses                StudentRegisteredCourse[]
  addDropRequests        CourseAddDropRequest[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@unique([studentId, academicSession, semester])
}

model StudentRegisteredCourse {
  id                String               @id @default(uuid())
  registrationId    String
  registration      SemesterRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  offeringId        String
  offering          CourseOffering       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  creditUnits       Int
  isClearedForExam  Boolean              @default(false)
  examDocketBarcode String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([registrationId, offeringId])
}

model ExamCandidateToken {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offeringId     String
  offering       CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  anonymousToken String         @unique // e.g. "CIN-83921"
  createdAt      DateTime       @default(now())

  @@unique([studentId, offeringId])
}

model StudentGrade {
  id                    String            @id @default(uuid())
  studentId             String
  student               StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offeringId            String
  offering              CourseOffering    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  caScore               Decimal           @db.Decimal(5, 2) // Max 40.00
  examScore             Decimal           @db.Decimal(5, 2) // Max 60.00
  totalScore            Decimal           @db.Decimal(5, 2) // caScore + examScore
  letterGrade           String            @db.VarChar(5)
  gradePoint            Decimal           @db.Decimal(3, 2)
  status                GradeStatus       @default(DRAFT)
  dataHash              String            @db.VarChar(64)   // Tamper-proof SHA-256
  isDoubleBlind         Boolean           @default(false)
  secondGraderExamScore Decimal?          @db.Decimal(5, 2)
  auditTrail            GradeAuditTrail[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([studentId, offeringId])
}

model GradeAuditTrail {
  id                 String       @id @default(uuid())
  gradeId            String
  grade              StudentGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  previousScore      Decimal      @db.Decimal(5, 2)
  newScore           Decimal      @db.Decimal(5, 2)
  reason             String       @db.Text
  senateApprovalRef  String
  changedById        String
  changedBy          User         @relation(fields: [changedById], references: [id])
  previousRecordHash String?      @db.VarChar(64)
  newRecordHash      String       @db.VarChar(64)
  createdAt          DateTime     @default(now())
}

model StudentAcademicStanding {
  id                   String         @id @default(uuid())
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession      String
  semester             Int
  gpa                  Decimal        @db.Decimal(4, 3)
  cgpa                 Decimal        @db.Decimal(4, 3)
  totalCreditsEarned   Int            @default(0)
  standing             String         // "GOOD_STANDING", "PROBATION", "WITHDRAWN"
  degreeClassification String?        // e.g., "First Class", "Summa Cum Laude"
  isRatified           Boolean        @default(false)
  ratifiedAt           DateTime?
  senateBatchRef       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([studentId, academicSession, semester])
}

// ==============================================================================
// E-LIBRARY MODULE
// ==============================================================================

model ELibraryBook {
  id              String                 @id @default(uuid())
  isbn            String?                @unique
  title           String
  author          String
