generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- SYSTEM SETTINGS ---
model SystemProfile {
  id              String    @id @default(cuid())
  name            String
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String    @default("#0f172a")
  secondaryColor  String    @default("#10b981")
  loginBgUrl      String?
  licenseStatus   String    @default("ACTIVE")
  expiresAt       DateTime?
  gradingScale    String?   @db.LongText
  aiConfig        String?   @db.LongText
  commConfig      String?   @db.LongText // JSON configuration for SMTP and WhatsApp gateways
  paymentConfig   String?   @db.LongText // JSON configuration for Paystack, Remita RRR, Monnify, and Bank Accounts
  currency        String?   @default("NGN")
  currencySymbol  String?   @default("₦")
  maintenanceMode Boolean   @default(false)
  enabledModules  String?   @db.LongText
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// --- CORE: Users & Identity ---

model User {
  id String @id @default(cuid())

  staffId      String? @unique
  username     String? @unique
  firstName    String
  lastName     String
  email        String  @unique
  phone        String?
  passwordHash String // Mandatory for all users
  role         String  @default("TEACHER")
  isSuperAdmin Boolean @default(false)

  // Security & Rate Limiting
  baseSalary          Float       @default(0)
  failedLoginAttempts Int         @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  requiresPasswordChange Boolean @default(true)
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  status              String      @default("active")
  avatarUrl           String?

  // Demographic & Employment Details
  gender              String?
  dateOfBirth         DateTime?
  stateOfOrigin       String?
  address             String?
  dateOfEmployment    DateTime?

  // Platform Integration Fields
  biometricId       String? @unique
  biometricTemplate String?
  kioskPin          String?
  deviceToken       String?
  fcmToken          String?

  // BAS (Biometric Attendance) Fields
  clockInTime         String? @default("08:00")
  clockOutTime        String? @default("17:00")
  gracePeriod         Int?    @default(15)
  restDays            String? @default("6,7")
  isBiometricEnrolled Boolean @default(false)

  // Scheduling
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  // Security & RBAC
  accessRoles AccessRole[]
  permissions Permission[]

  sentMemos    StaffMemo[]        @relation("MemoSender")
  handledMemos StaffMemo[]        @relation("MemoHandler")
  memoActions  StaffMemoHistory[] @relation("MemoActor")

  // Bank & Payroll Details
  bankName      String?
  accountNumber String?
  accountName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lessonNotes                 LessonNote[]
  reviewedLessonNotes         LessonNote[]               @relation("LessonNoteReviewer")
  notifications               Notification[]
  announcements               Announcement[]
  contracts                   Contract[]
  payroll                     Payroll[]
  classesTaught               Class[]
  auditLogs                   AuditLog[]
  staffAttendance             StaffAttendance[]
  clinicVisits                ClinicVisit[]
  reportedIncidents           BehavioralIncident[]       @relation("ReportedIncidents")
  timetables                  Timetable[]                @relation("TimetableTeacher")
  receiptsLogged              PaymentReceipt[]
  guardianProfile             Guardian?
  leaveRequests               LeaveRequest[]
  subAssignments              SubstituteAssignment[]
  messageBlasts               MessageBlast[]
  recordedExpenses            Expense[]                  @relation("RecordedExpenses")
  StaffPayrollSubscription    StaffPayrollSubscription[]
  createdGradebookAssignments GradebookAssignment[]      @relation("GradebookAssignmentCreator")

  raisedMemos     Memo[]       @relation("MemoRaisedBy")
  receivedMemos   Memo[]       @relation("MemoRaisedFor")
  sentMinutes     MemoMinute[] @relation("MinuteFromUser")
  receivedMinutes MemoMinute[] @relation("MinuteToUser")

  routesAsDriver   TransportRoute[]   @relation("DriverRoutes")
  dispatches       VehicleDispatch[]  @relation("DriverDispatches")

  studentProfile              StudentProfile?
  staffProfile                StaffProfile?
  gradeAuditLogs              GradeAuditTrail[]
  borrowedBooks               ELibraryBorrowRecord[]
  fuelLogs         FuelLog[]          @relation("FuelLogsRecorded")
  interviews       Interview[]        @relation("InterviewsConducted")
  loans            StaffLoan[]        @relation("StaffLoans")
  approvedLoans    StaffLoan[]        @relation("LoansApproved")
  allowances       PayrollAllowance[] @relation("StaffAllowances")
  journalEntries   JournalEntry[]     @relation("JournalEntriesRecorded")
  assetAssignments AssetAssignment[]  @relation("AssetsAssigned")
  scoreAuditsModified ScoreAuditLog[] @relation("ScoreAuditsModified")
  senateSeals         SenateBatchSeal[]
  vouchersCreated     PaymentVoucher[] @relation("VoucherCreatedBy")
  vouchersChecked     PaymentVoucher[] @relation("VoucherCheckedBy")
  vouchersVerified    PaymentVoucher[] @relation("VoucherVerifiedBy")
  vouchersApproved    PaymentVoucher[] @relation("VoucherApprovedBy")
  vouchersPosted      PaymentVoucher[] @relation("VoucherPostedBy")
  vouchersCancelled   PaymentVoucher[] @relation("VoucherCancelledBy")
  voucherAudits       PaymentVoucherAudit[] @relation("VoucherAuditActor")
  parentWallet        ParentWallet?
  @@index([role, status])
  @@index([departmentId])
}

model Department {
  id        String    @id @default(cuid())
  name      String
  hodId     String?
  createdAt DateTime  @default(now())
  users     User[]
  subjects  Subject[]

  jobPostings JobPosting[]
  programs    AcademicProgram[]
  staffProfiles StaffProfile[]
  facultyId     String?
  faculty       Faculty?               @relation(fields: [facultyId], references: [id])

  @@unique([name])
}

// --- ACADEMICS: SIS, Grading & Learning ---

model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  terms     Term[]
  admissionCampaigns AdmissionCampaign[]
  hostelAllocations  HostelAllocation[]
  createdAt DateTime @default(now())

  @@unique([name])
  @@index([isActive])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  eventType   String
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
}

model Term {
  id        String          @id @default(cuid())
  name      String
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  startDate DateTime
  endDate   DateTime
  isActive  Boolean         @default(false)

  // Relations
  enrollments            Enrollment[]
  classes                Class[]
  assignments            Assignment[]
  attendance             Attendance[]
  lessonNotes            LessonNote[]
  timetables             Timetable[]
  termGrades             TermGrade[]
  invoices               Invoice[]
  lmsModules             LmsModule[]
  behaviouralAssessments BehaviouralAssessment[]
  tahfeezScores          TahfeezScore[]
  midtermResults         MidtermResult[]
  resultTokens           ResultToken[]
  gradebookAssignments   GradebookAssignment[]   @relation("GradebookTerm")
  behaviouralScores      BehaviouralScore[]      @relation("BehaviouralScoreTerm")

  createdAt DateTime @default(now())

  @@unique([name, sessionId])
  @@index([isActive])
  @@index([sessionId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  termId    String
  term      Term     @relation(fields: [termId], references: [id])
  status    String   @default("Active")
  createdAt DateTime @default(now())

  @@unique([studentId, termId])
}

model Class {
  id              String   @id @default(cuid())
  name            String
  teacherId       String?
  teacher         User?    @relation(fields: [teacherId], references: [id])
  termId          String?
  term            Term?    @relation(fields: [termId], references: [id])
  subjectIds      String? // JSON array of strings
  subjectTeachers String? // JSON object mapping subjectId to teacherId
  createdAt       DateTime @default(now())

  // Relations
  assignments          Assignment[]
  enrollments          Enrollment[]
  currentStudents      Student[]             @relation("CurrentClass")
  attendance           Attendance[]
  lessonNotes          LessonNote[]
  timetable            Timetable[]
  LmsModule            LmsModule[]
  gradebookAssignments GradebookAssignment[] @relation("GradebookClass")

  @@unique([name])
}

model Subject {
  id           String      @id @default(cuid())
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  // Relations
  assignments          Assignment[]
  standards            Standard[]
  lessonNotes          LessonNote[]
  attendance           Attendance[]
  timetable            Timetable[]
  termGrades           TermGrade[]
  LmsModule            LmsModule[]
  midtermResults       MidtermResult[]
  gradebookAssignments GradebookAssignment[] @relation("GradebookSubject")

  @@unique([name])
}

model Standard {
  id          String       @id @default(cuid())
  code        String
  description String
  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id])
  assignments Assignment[]

  @@unique([code])
}

model Student {
  id            String   @id @default(cuid())
  studentId     String
  firstName     String
  lastName      String
  middleName    String?
  gender        String
  dateOfBirth   DateTime
  classId       String?
  class         Class?   @relation("CurrentClass", fields: [classId], references: [id])
  sessionYear   String   @default("2024/2025")
  status        String   @default("Active")
  admissionDate DateTime @default(now())

  biometricId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  enrollments            Enrollment[]
  guardians              Guardian[]
  attendance             Attendance[]
  invoices               Invoice[]
  hostelAllocations      HostelAllocation[]
  healthRecord           HealthRecord?
  incidents              BehavioralIncident[]
  termGrades             TermGrade[]
  submissions            Submission[]
  quizAttempts           QuizAttempt[]
  behaviouralAssessments BehaviouralAssessment[]
  tahfeezScores          TahfeezScore[]
  midtermResults         MidtermResult[]
  resultTokens           ResultToken[]
  gradebookScores        GradebookScore[]
  behaviouralScores      BehaviouralScore[]

  @@unique([studentId])
  @@index([status, classId])
  @@index([sessionYear])
}

model Guardian {
  id           String  @id @default(cuid())
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id])
  fullName     String
  relationship String
  phone        String
  email        String
  address      String
  isPrimary    Boolean @default(false)
  studentId    String
  student      Student @relation(fields: [studentId], references: [id])
}

model LessonNote {
  id             String    @id @default(cuid())
  title          String
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id])
  classId        String
  class          Class     @relation(fields: [classId], references: [id])
  teacherId      String
  teacher        User      @relation(fields: [teacherId], references: [id])
  status         String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  submissionDate DateTime  @default(now())
  fileUrl        String?
  content        String?   @db.Text
  termId         String?
  term           Term?     @relation(fields: [termId], references: [id])
  weekNumber     Int?
  objectives     String?   @db.Text // Learning objectives
  activities     String?   @db.Text // Planned activities
  resources      String?   @db.Text // Materials needed
  evaluation     String?   @db.Text // Assessment strategy
  reviewerId     String?
  reviewer       User?     @relation("LessonNoteReviewer", fields: [reviewerId], references: [id])
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// --- ATTENDANCE & SCHEDULING ---

model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  classId    String
  class      Class    @relation(fields: [classId], references: [id])
  subjectId  String?
  subject    Subject? @relation(fields: [subjectId], references: [id])
  date       DateTime @default(now())
  status     String
  method     String   @default("MANUAL")
  locationId String?
  location   Room?    @relation(fields: [locationId], references: [id])
  termId     String?
  term       Term?    @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())
  @@index([date, classId])
  @@index([studentId, termId])
}

model Room {
  id         String       @id @default(cuid())
  name       String
  capacity   Int?
  building   String?
  attendance Attendance[]
  timetable  Timetable[]

  @@unique([name])
}

model Timetable {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  roomId    String?
  room      Room?   @relation(fields: [roomId], references: [id])
  teacherId String?
  teacher   User?   @relation("TimetableTeacher", fields: [teacherId], references: [id])
  termId    String?
  term      Term?   @relation(fields: [termId], references: [id])

  dayOfWeek Int
  startTime String
  endTime   String

  substitutes SubstituteAssignment[]
}

// --- STAFF ATTENDANCE & BIOMETRICS ---

model Kiosk {
  id              String   @id @default(cuid())
  terminalId      String   @unique
  name            String
  ipAddress       String?
  lastSeenAt      DateTime @default(now())
  isActive        Boolean  @default(false)
  maintenanceMode Boolean  @default(false)
  operatingMode   String   @default("auto")
  branchId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceLogs StaffAttendance[]
  terminalLogs   StaffAttendance[] @relation("KioskTerminalLogs")
}

model Shift {
  id          String @id @default(cuid())
  name        String
  startTime   String
  endTime     String
  gracePeriod Int    @default(15)

  users User[]

  @@unique([name])
}

model StaffAttendance {
  id      String   @id @default(cuid())
  staffId String
  staff   User     @relation(fields: [staffId], references: [id])
  date    DateTime @default(now())
  timeIn  String?
  timeOut String?
  type    Int      @default(1)
  source  String

  kioskId    String?
  kiosk      Kiosk?  @relation(fields: [kioskId], references: [id])
  terminalId String?
  terminal   Kiosk?  @relation("KioskTerminalLogs", fields: [terminalId], references: [terminalId])

  isLate          Boolean @default(false)
  latenessMinutes Int?    @default(0)
  durationHours   Float?  @default(0)
  overtimeHours   Float?  @default(0)

  isDisputed    Boolean @default(false)
  disputeReason String?

  memoId String?
  memo   StaffMemo? @relation("AttendanceMemo", fields: [memoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([date, staffId])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- FINANCE: ERP & Payroll ---

model Fund {
  id           String        @id @default(cuid())
  name         String
  balance      Float         @default(0)
  budgets      Budget[]
  transactions Transaction[]

  @@unique([name])
}

model Budget {
  id        String @id @default(cuid())
  fundId    String
  fund      Fund   @relation(fields: [fundId], references: [id])
  year      Int
  allocated Float
  spent     Float  @default(0)
  category  String
}

model Contract {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  salary    Float
  startDate DateTime
  endDate   DateTime?
  status    String    @default("active")
}

model Payroll {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  month               Int
  year                Int
  baseAmount          Float     @default(0)
  deductions          Float     @default(0)
  bonuses             Float     @default(0)
  netAmount           Float     @default(0)
  tax                 Float     @default(0)
  pension             Float     @default(0)
  attendancePenalty   Float     @default(0)
  loanDeduction       Float     @default(0)
  allowances          Float     @default(0)
  holdReason          String?
  heldAt              DateTime?
  heldById            String?
  disbursedById       String?
  approvedById        String?
  payslipSentAt       DateTime?
  basReport           String?
  subscriptionsReport String?
  status              String    @default("pending") // pending, paid, held
  paidAt              DateTime?
}

model Transaction {
  id          String   @id @default(cuid())
  fundId      String
  fund        Fund     @relation(fields: [fundId], references: [id])
  amount      Float
  type        String
  description String   @db.Text
  createdAt   DateTime @default(now())
}

model Invoice {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  termId    String
  term      Term    @relation(fields: [termId], references: [id])

  amount      Float
  amountPaid  Float    @default(0)
  balance     Float
  dueDate     DateTime
  status      String   @default("UNPAID")
  description String   @db.Text

  receipts PaymentReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, termId])
  @@index([studentId, status])
}

model PaymentReceipt {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Float
  method    String   @default("CASH")
  reference String?
  date      DateTime @default(now())
  status    String   @default("VERIFIED") // VERIFIED, PENDING, REVERSED
  payerName String?
  reversalReason String?
  reversedAt     DateTime?
  reversedById   String?

  loggedById String
  loggedBy   User   @relation(fields: [loggedById], references: [id])
  @@index([date])
  @@index([invoiceId])
}

// --- SYSTEM: Infrastructure ---

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, read, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId])
}

// --- MEDICAL & HEALTH RECORDS ---

model HealthRecord {
  id                    String  @id @default(cuid())
  studentId             String  @unique
  student               Student @relation(fields: [studentId], references: [id])
  bloodGroup            String?
  genotype              String?
  allergies             String?
  chronicIllness        String?
  emergencyContactName  String?
  emergencyContactPhone String?

  immunizations Immunization[]
  clinicVisits  ClinicVisit[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Immunization {
  id             String       @id @default(cuid())
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id])
  vaccineName    String
  dateGiven      DateTime?
  status         String       @default("Pending")
  notes          String?

  createdAt DateTime @default(now())
}

model ClinicVisit {
  id             String       @id @default(cuid())
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id])
  nurseId        String?
  nurse          User?        @relation(fields: [nurseId], references: [id])
  date           DateTime     @default(now())
  symptoms       String
  diagnosis      String?
  treatment      String?
  sentHome       Boolean      @default(false)
  notes          String?

  createdAt DateTime @default(now())
}

// --- DISCIPLINE & BEHAVIOR ---

model BehavioralIncident {
  id         String  @id @default(cuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])
  reporterId String
  reporter   User    @relation("ReportedIncidents", fields: [reporterId], references: [id])

  title       String
  description String   @db.Text
  severity    String   @default("MINOR")
  date        DateTime @default(now())
  status      String   @default("OPEN")

  actions IncidentAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncidentAction {
  id          String             @id @default(cuid())
  incidentId  String
  incident    BehavioralIncident @relation(fields: [incidentId], references: [id])
  actionTaken String
  details     String?
  date        DateTime           @default(now())

  createdAt DateTime @default(now())
}

// --- GRADING & ASSESSMENT ---

model TermGrade {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  termId    String
  term      Term    @relation(fields: [termId], references: [id])

  ca1     Float?
  ca2     Float?
  exam    Float?
  total   Float?
  grade   String?
  remarks String?

  // Enhanced result fields
  classRank       Int?
  classSize       Int?
  overallAverage  Float?
  teacherRemark   String?
  principalRemark String?
  isPublished     Boolean @default(false)
  status          String  @default("Draft")

  // Governance & Moderation Fields
  moderatorNote   String?   // Strictly internal review notes (never printed on parent report cards)
  submittedAt     DateTime?
  submittedById   String?
  reviewedAt      DateTime?
  reviewedById    String?
  isLocked        Boolean   @default(false)

  // Audit of original teacher marks
  originalCa1     Float?
  originalCa2     Float?
  originalExam    Float?
  scoreAuditLogs  ScoreAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, termId])
  @@index([termId, subjectId])
  @@index([studentId, termId])
}

model ScoreAuditLog {
  id          String    @id @default(cuid())
  termGradeId String
  termGrade   TermGrade @relation(fields: [termGradeId], references: [id], onDelete: Cascade)
  studentId   String
  subjectId   String
  termId      String
  modifierId  String
  modifier    User      @relation("ScoreAuditsModified", fields: [modifierId], references: [id])
  field       String    // "ca1" | "ca2" | "exam"
  oldValue    Float?
  newValue    Float?
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([termGradeId])
  @@index([termId, subjectId])
}

// --- HR & SUBSTITUTE MANAGEMENT ---

model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model SubstituteAssignment {
  id           String    @id @default(cuid())
  substituteId String
  substitute   User      @relation(fields: [substituteId], references: [id])
  timetableId  String
  timetable    Timetable @relation(fields: [timetableId], references: [id])
  date         DateTime
  assignedAt   DateTime  @default(now())

  @@unique([timetableId, date])
}

// --- CORE ERP: RBAC & Authentication ---
model AccessRole {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String       @id @default(cuid())
  action      String
  resource    String
  description String?
  roles       AccessRole[]
  users       User[]

  @@unique([action, resource])
}

// --- COMMUNICATION HUB ---

model MessageBlast {
  id           String   @id @default(cuid())
  senderId     String
  sender       User     @relation(fields: [senderId], references: [id])
  subject      String
  body         String
  audienceType String
  targetId     String?
  channel      String
  sentCount    Int      @default(0)
  sentAt       DateTime @default(now())
}

// --- LMS: LEARNING MANAGEMENT ---

model LmsModule {
  id          String       @id @default(cuid())
  title       String
  order       Int          @default(0)
  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     String
  class       Class        @relation(fields: [classId], references: [id])
  content     LmsContent[]
  assignments Assignment[]
  quizzes     Quiz[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  termId      String?
  term        Term?        @relation(fields: [termId], references: [id])
}

model LmsContent {
  id        String    @id @default(cuid())
  moduleId  String
  module    LmsModule @relation(fields: [moduleId], references: [id])
  title     String
  type      String
  url       String?
  body      String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Assignment {
  id              String       @id @default(cuid())
  title           String
  description     String?      @db.Text
  points          Int          @default(100)
  dueDate         DateTime?
  assessmentType  String       @default("ASSIGNMENT") // "ASSIGNMENT" or "ESSAY_EXAM"
  durationMinutes Int?         // Working session countdown timer in minutes (e.g., 45, 60)
  moduleId        String
  module          LmsModule    @relation(fields: [moduleId], references: [id])
  submissions     Submission[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  termId          String?
  term            Term?        @relation(fields: [termId], references: [id])
  classId         String?
  class           Class?       @relation(fields: [classId], references: [id])
  subjectId       String?
  subject         Subject?     @relation(fields: [subjectId], references: [id])
  standardId      String?
  standard        Standard?    @relation(fields: [standardId], references: [id])
}

model Submission {
  id              String     @id @default(cuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id])
  fileUrl         String?
  body            String?
  score           Float?
  feedback        String?
  pasteCount      Int        @default(0)
  tabSwitchCount  Int        @default(0)
  isPasteFlagged  Boolean    @default(false)
  similarityScore Float?
  startedAt       DateTime?  // Recorded as soon as student activates/opens session
  submittedAt     DateTime   @default(now())
  gradedAt        DateTime?
}

model Quiz {
  id          String         @id @default(cuid())
  title       String
  description String?   @db.Text
  points      Int            @default(100)
  timeLimit   Int?
  moduleId    String
  module      LmsModule      @relation(fields: [moduleId], references: [id])
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model QuizQuestion {
  id            String  @id @default(cuid())
  quizId        String
  quiz          Quiz    @relation(fields: [quizId], references: [id])
  question      String
  type          String
  options       String?
  correctAnswer String
  points        Int     @default(10)
  order         Int     @default(0)
}

model QuizAttempt {
  id              String    @id @default(cuid())
  quizId          String
  quiz            Quiz      @relation(fields: [quizId], references: [id])
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  answers         String
  score           Float?
  pasteCount      Int       @default(0)
  tabSwitchCount  Int       @default(0)
  isPasteFlagged  Boolean   @default(false)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
}

// --- MISSING ERP MODELS ---

model Expense {
  id            String   @id @default(cuid())
  category      String
  description   String
  amount        Float
  date          DateTime @default(now())
  department    String?
  paymentMethod String?  @default("CASH")
  vendor        String?
  receiptUrl    String?
  notes         String?
  recordedBy    String
  recordedByU   User     @relation("RecordedExpenses", fields: [recordedBy], references: [id])
  createdAt     DateTime @default(now())

  memoId String?
  memo   StaffMemo? @relation("ExpenseMemo", fields: [memoId], references: [id])
  @@index([date])
}

model FeeStructure {
  id          String    @id @default(cuid())
  name        String?
  className   String
  category    String?   @default("TUITION")
  scope       String?   @default("CLASS")
  session     String
  term        String
  totalAmount Float     @default(0)
  status      String    @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  items       FeeItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model FeeItem {
  id             String       @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  name           String
  amount         Float
}

// --- NEW GRADING/ASSESSMENT & RESULT MODELS ---

model BehaviouralAssessment {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  session       String
  conduct       Int      @default(3)
  punctuality   Int      @default(3)
  dedication    Int      @default(3)
  participation Int      @default(3)
  hospitality   Int      @default(3)
  neatness      Int      @default(3)
  creativity    Int      @default(3)
  physical      Int      @default(3)
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, termId])
}

model TahfeezScore {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  termId            String
  term              Term     @relation(fields: [termId], references: [id])
  session           String
  surah             String?
  juz               Int?
  page              Int?
  marks             Float
  tajweedScore      Float? // 1-10
  fluencyScore      Float? // 1-10
  memorizationScore Float? // 1-10
  startAyah         Int?
  endAyah           Int?
  teacherNote       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// --- DYNAMIC GRADEBOOK ---

model GradingScale {
  id        String              @id @default(cuid())
  name      String              @unique
  isDefault Boolean             @default(false)
  entries   GradingScaleEntry[]
  createdAt DateTime            @default(now())
}

model GradingScaleEntry {
  id            String       @id @default(cuid())
  scaleId       String
  scale         GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade         String // "A1", "B2", "C4", etc.
  label         String // "Excellent", "Very Good", etc.
  minPercentage Float // 75.0
  maxPercentage Float // 100.0
  gpaPoints     Float? // 4.0

  @@unique([scaleId, grade])
}

model AssignmentCategory {
  id          String                @id @default(cuid())
  name        String                @unique // "CA Test", "Assignment", "Examination"
  weight      Float // 0.4 (40%)
  maxScore    Float                 @default(100)
  sortOrder   Int                   @default(0)
  assignments GradebookAssignment[]
}

model GradebookAssignment {
  id          String             @id @default(cuid())
  title       String // "CA1 Test - Week 3"
  categoryId  String
  category    AssignmentCategory @relation(fields: [categoryId], references: [id])
  subjectId   String
  subject     Subject            @relation("GradebookSubject", fields: [subjectId], references: [id])
  classId     String
  class       Class              @relation("GradebookClass", fields: [classId], references: [id])
  termId      String
  term        Term               @relation("GradebookTerm", fields: [termId], references: [id])
  maxScore    Float              @default(100)
  dueDate     DateTime?
  createdById String
  createdBy   User               @relation("GradebookAssignmentCreator", fields: [createdById], references: [id])
  isPublished Boolean            @default(false)
  scores      GradebookScore[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model GradebookScore {
  id           String              @id @default(cuid())
  assignmentId String
  assignment   GradebookAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student             @relation(fields: [studentId], references: [id])
  score        Float?
  isMissing    Boolean             @default(false)
  isLate       Boolean             @default(false)
  isExcused    Boolean             @default(false)
  isExempt     Boolean             @default(false)
  comment      String?
  gradedAt     DateTime            @default(now())

  @@unique([assignmentId, studentId])
}

model BehaviouralTrait {
  id        String             @id @default(cuid())
  name      String             @unique // "Punctuality", "Neatness"
  category  String // "AFFECTIVE" or "PSYCHOMOTOR"
  sortOrder Int                @default(0)
  scores    BehaviouralScore[]
}

model BehaviouralScore {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  traitId   String
  trait     BehaviouralTrait @relation(fields: [traitId], references: [id])
  termId    String
  term      Term             @relation("BehaviouralScoreTerm", fields: [termId], references: [id])
  score     Int // 1-5 Likert scale

  @@unique([studentId, traitId, termId])
}

model MidtermResult {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  termId      String
  term        Term     @relation(fields: [termId], references: [id])
  session     String
  score       Float
  status      String   @default("PENDING")
  achievement String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, subjectId, termId])
}

model ResultToken {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  termId     String
  term       Term     @relation(fields: [termId], references: [id])
  session    String
  token      String   @unique
  usageCount Int      @default(0)
  maxUsage   Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, termId])
}

// --- INVENTORY ---
model Supplier {
  id        String           @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  items     InventoryItem[]
  orders    InventoryOrder[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model InventoryItem {
  id          String    @id @default(cuid())
  name        String
  category    String?
  quantity    Int       @default(0)
  minQuantity Int       @default(5)
  unit        String?
  price       Float     @default(0)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InventoryOrder {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  status      String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  totalAmount Float    @default(0)
  items       String // JSON string of {itemId, quantity, price}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PayrollSubscriptionType {
  id           String   @id @default(cuid())
  name         String
  amount       Float
  isPercentage Boolean  @default(false)
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions StaffPayrollSubscription[]
}

model StaffPayrollSubscription {
  id                 String                  @id @default(cuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id])
  subscriptionTypeId String
  subscriptionType   PayrollSubscriptionType @relation(fields: [subscriptionTypeId], references: [id])
  status             String                  @default("ACTIVE") // ACTIVE, CANCEL_REQUESTED, CANCELLED
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model StaffMemo {
  id        String @id @default(cuid())
  reference String @unique
  type      String // "MESSAGE", "LEAVE_REQUEST", "CASH_VOUCHER"
  title     String
  content   String @db.Text

  senderId String
  sender   User   @relation("MemoSender", fields: [senderId], references: [id])

  currentHandlerId String?
  currentHandler   User?   @relation("MemoHandler", fields: [currentHandlerId], references: [id])

  status     String  @default("PENDING") // PENDING, APPROVED, REJECTED, KIV, CLOSED
  readStatus Boolean @default(false)

  metadata String? // JSON for Leave dates, Voucher amounts, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history        StaffMemoHistory[]
  attendanceLogs StaffAttendance[]  @relation("AttendanceMemo")
  expenses       Expense[]          @relation("ExpenseMemo")
}

model StaffMemoHistory {
  id        String    @id @default(cuid())
  memoId    String
  memo      StaffMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User      @relation("MemoActor", fields: [actorId], references: [id])
  action    String // CREATED, FORWARDED, KIV, REJECTED, APPROVED
  notes     String?
  createdAt DateTime  @default(now())
}

// --- ALBABELLO ARCHITECTURE: MEMOS & COMMUNICATIONS ---

model Memo {
  id          String   @id @default(uuid())
  reference   String   @unique
  title       String
  body        String
  raisedById  String
  raisedForId String
  dateRaised  DateTime @default(now())
  status      String   @default("OPEN")
  readStatus  String   @default("NOT_SEEN")
  type        String   @default("MEMO")

  raisedBy  User @relation("MemoRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  raisedFor User @relation("MemoRaisedFor", fields: [raisedForId], references: [id], onDelete: Cascade)

  minutes          MemoMinute[]
  paymentProcesses PaymentProcess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemoMinute {
  id              String @id @default(uuid())
  memoId          String
  body            String
  flag            String
  fromUserId      String
  toUserId        String
  confidentiality String @default("NOT_CONFIDENTIAL")
  status          String @default("NOT_SEEN")

  memo     Memo @relation(fields: [memoId], references: [id], onDelete: Cascade)
  fromUser User @relation("MinuteFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("MinuteToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentProcess {
  id              String  @id @default(uuid())
  memoId          String
  accountDebited  String?
  accountCredited String?
  amount          Float?
  beneficiaryType String?
  beneficiary     String?
  narration       String?

  memo Memo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- 1. FLEET & TRANSPORT MANAGEMENT ---
model Vehicle {
  id             String @id @default(uuid())
  registrationNo String @unique
  make           String
  model          String
  year           Int
  capacity       Int
  status         String @default("ACTIVE") // ACTIVE, MAINTENANCE, OUT_OF_SERVICE

  dispatches VehicleDispatch[]
  fuelLogs   FuelLog[]
  routes     TransportRoute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransportRoute {
  id          String  @id @default(uuid())
  name        String
  description String?
  vehicleId   String?
  driverId    String?

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  driver  User?    @relation("DriverRoutes", fields: [driverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleDispatch {
  id            String    @id @default(uuid())
  vehicleId     String
  driverId      String
  destination   String
  purpose       String
  departureTime DateTime
  returnTime    DateTime?
  status        String    @default("OUTBOUND") // OUTBOUND, RETURNED

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  User    @relation("DriverDispatches", fields: [driverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FuelLog {
  id           String   @id @default(uuid())
  vehicleId    String
  date         DateTime @default(now())
  liters       Float
  costPerLiter Float
  totalCost    Float
  loggedById   String

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id])
  loggedBy User    @relation("FuelLogsRecorded", fields: [loggedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- 2. RECRUITMENT & ATS ---
model JobPosting {
  id           String   @id @default(uuid())
  title        String
  departmentId String
  description  String
  requirements String
  status       String   @default("OPEN") // OPEN, CLOSED, DRAFT
  deadline     DateTime

  department   Department       @relation(fields: [departmentId], references: [id])
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id          String  @id @default(uuid())
  jobId       String
  firstName   String
  lastName    String
  email       String
  phone       String
  resumeUrl   String?
  coverLetter String?
  status      String  @default("PENDING") // PENDING, REVIEWING, INTERVIEW, HIRED, REJECTED

  job        JobPosting  @relation(fields: [jobId], references: [id])
  interviews Interview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Interview {
  id            String   @id @default(uuid())
  applicationId String
  interviewerId String
  scheduledAt   DateTime
  location      String
  notes         String?
  result        String? // PASSED, FAILED

  application JobApplication @relation(fields: [applicationId], references: [id])
  interviewer User           @relation("InterviewsConducted", fields: [interviewerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- 3. ADVANCED PAYROLL (LOANS & ADVANCES) ---
model StaffLoan {
  id               String  @id @default(uuid())
  userId           String
  amount           Float
  reason           String?
  monthlyDeduction Float
  remainingBalance Float
  status           String  @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  approvedById     String?

  user       User  @relation("StaffLoans", fields: [userId], references: [id])
  approvedBy User? @relation("LoansApproved", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollAllowance {
  id          String  @id @default(uuid())
  userId      String
  type        String // HOUSING, TRANSPORT, BONUS
  amount      Float
  isRecurring Boolean @default(true)

  user User @relation("StaffAllowances", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- 4. GENERAL LEDGER ACCOUNTING ---
model AccountCategory {
  id          String  @id @default(uuid())
  name        String  @unique // Asset, Liability, Equity, Revenue, Expense
  description String?

  accounts AccountCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountCode {
  id         String @id @default(uuid())
  code       String @unique // e.g. 1000, 2000
  name       String
  categoryId String
  balance    Float  @default(0.0)

  category     AccountCategory @relation(fields: [categoryId], references: [id])
  journalLines JournalLine[]
  sourceVouchers PaymentVoucher[] @relation("VoucherSourceAccount")
  voucherLines   PaymentVoucherLine[] @relation("VoucherLineAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalEntry {
  id           String   @id @default(uuid())
  reference    String   @unique
  date         DateTime
  description  String
  recordedById String

  recordedBy User          @relation("JournalEntriesRecorded", fields: [recordedById], references: [id])
  lines      JournalLine[]
  voucher    PaymentVoucher? @relation("VoucherJournalEntry")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalLine {
  id          String  @id @default(uuid())
  entryId     String
  accountId   String
  debit       Float   @default(0.0)
  credit      Float   @default(0.0)
  description String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account AccountCode  @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessPartner {
  id           String  @id @default(uuid())
  name         String
  type         String // VENDOR, CUSTOMER
  contactEmail String?
  contactPhone String?
  balance      Float   @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- 5. ASSET MANAGEMENT ---
model AssetCategory {
  id               String @id @default(uuid())
  name             String @unique
  depreciationRate Float  @default(0.0) // percentage per year

  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id            String   @id @default(uuid())
  tagNumber     String   @unique
  name          String
  categoryId    String
  purchaseDate  DateTime
  purchasePrice Float
  currentValue  Float
  status        String   @default("AVAILABLE") // AVAILABLE, ASSIGNED, MAINTENANCE, RETIRED

  category    AssetCategory     @relation(fields: [categoryId], references: [id])
  assignments AssetAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
