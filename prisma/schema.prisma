// ==============================================================================
// COMPUTER-BASED TESTING (CBT) ENGINE
// ==============================================================================

model CbtExam {
  id               String            @id @default(uuid())
  courseOfferingId String?
  courseOffering   CourseOffering?   @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  title            String
  description      String?           @db.Text
  durationMinutes  Int               @default(60)
  totalMarks       Float             @default(40.0) // E.g., Continuous Assessment (CA)
  targetCategory   String            @default("CA") // "CA" or "EXAM"
  passPercentage   Float             @default(50.0)
  isPublished      Boolean           @default(false)
  allowRetake      Boolean           @default(false)
  antiCheatLevel   String            @default("STRICT") // NONE, STANDARD, STRICT
  maxTabSwitches   Int               @default(3)
  questions        CbtQuestion[]
  submissions      CbtSubmission[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CbtQuestion {
  id            String      @id @default(uuid())
  examId        String
  exam          CbtExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String      @db.Text
  questionType  String      @default("MULTIPLE_CHOICE")
  optionsJson   String      @db.Text // JSON: [{"id": "A", "text": "..."}]
  correctOption String      // "A", "B", "C", "D"
  points        Float       @default(2.0)
  orderIndex    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CbtSubmission {
  id               String         @id @default(uuid())
  examId           String
  exam             CbtExam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  startedAt        DateTime       @default(now())
  submittedAt      DateTime?
  scoreAchieved    Float          @default(0.0)
  percentageScore  Float          @default(0.0)
  answersJson      String         @db.LongText
  tabSwitchCount   Int            @default(0)
  isAutoSubmitted  Boolean        @default(false)
  isPipedToGrades  Boolean        @default(false)
  status           String         @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, DISQUALIFIED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([examId, studentProfileId])
}

// ==============================================================================
// MULTI-CAMPUS & FACULTY MANAGEMENT
// ==============================================================================

model Campus {
  id          String         @id @default(uuid())
  code        String         @unique // e.g. "MAIN", "MED", "CITY"
  name        String
  address     String?
  isMain      Boolean        @default(false)
  faculties   Faculty[]
  venues      LectureVenue[]
  hostels     Hostel[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Faculty {
  id          String            @id @default(uuid())
  code        String            @unique // e.g. "FCI", "ENG", "LAW"
  name        String
  campusId    String?
  campus      Campus?           @relation(fields: [campusId], references: [id])
  deanId      String?
  dean        StaffProfile?     @relation("FacultyDean", fields: [deanId], references: [id])
  departments Department[]
  programs    AcademicProgram[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model LectureVenue {
  id          String           @id @default(uuid())
  campusId    String?
  campus      Campus?          @relation(fields: [campusId], references: [id])
  name        String           // e.g. "Auditorium A", "Computing Lab 1"
  capacity    Int              @default(100)
  building    String?
  schedules   CourseSchedule[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ==============================================================================
// TIMETABLE & CLASH DETECTION ENGINE
// ==============================================================================

model CourseSchedule {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  venueId          String?
  venue            LectureVenue?  @relation(fields: [venueId], references: [id])
  dayOfWeek        String         // "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"
  startTime        String         // e.g. "08:00"
  endTime          String         // e.g. "10:00"
  scheduleType     String         @default("LECTURE") // LECTURE, LAB, TUTORIAL, EXAM
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ==============================================================================
// TERTIARY BURSARY & TUITION BILLING
// ==============================================================================

model TertiaryFeeStructure {
  id              String          @id @default(uuid())
  programId       String
  program         AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicSession String
  semester        Int
  tuitionFee      Float           @default(150000.0)
  acceptanceFee   Float           @default(0.0)
  labFee          Float           @default(20000.0)
  ictFee          Float           @default(15000.0)
  totalAmount     Float           @default(185000.0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([programId, academicSession, semester])
}

model TertiaryInvoice {
  id               String         @id @default(uuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession  String
  semester         Int
  totalAmount      Float
  amountPaid       Float          @default(0.0)
  balanceDue       Float
  status           String         @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  paymentReference String?
  paymentDate      DateTime?
  paymentMethod    String?        // "PAYSTACK", "FLUTTERWAVE", "BANK_TRANSFER"
  receiptUrl       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentId, academicSession, semester])
  @@index([studentId, status])
}

// ==============================================================================
// COURSE ADD / DROP & LATE REGISTRATION
// ==============================================================================

model CourseAddDropRequest {
  id               String               @id @default(uuid())
  studentId        String
  student          StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  registrationId   String
  registration     SemesterRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  offeringId       String
  offering         CourseOffering       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  requestType      String               // "ADD" or "DROP"
  reason           String               @db.Text
  status           String               @default("PENDING") // PENDING, APPROVED, REJECTED
  lateFeeAmount    Float                @default(0.0)
  isLateFeePaid    Boolean              @default(false)
  reviewedById     String?
  reviewedBy       StaffProfile?        @relation(fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  rejectionNote    String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

// ==============================================================================
// SENATE MERKLE SEALING & CRYPTOGRAPHIC PROOFS
// ==============================================================================

model SenateBatchSeal {
  id              String        @id @default(uuid())
  academicSession String
  semester        Int
  batchReference  String        @unique // e.g. "SEN/SEAL/20252026/S1"
  merkleRootHash  String        @db.VarChar(64)
  totalRecords    Int
  sealedById      String
  sealedBy        User          @relation(fields: [sealedById], references: [id])
  sealedAt        DateTime      @default(now())
  isImmutable     Boolean       @default(true)
  createdAt       DateTime      @default(now())
}

// ==============================================================================
// TERTIARY LECTURER PORTAL & STUDENT ACTIVITY HUB (LMS & DIGITAL CLASSROOM)
// ==============================================================================

model CourseLecturer {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  staffId          String
  staff            StaffProfile   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role             String         @default("PRIMARY_LECTURER") // PRIMARY_LECTURER, CO_LECTURER, TEACHING_ASSISTANT
  createdAt        DateTime       @default(now())

  @@unique([courseOfferingId, staffId])
}

model TertiaryLectureMaterial {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       StaffProfile   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  title            String         @db.Text
  description      String?        @db.Text
  weekNumber       Int?           @default(1)
  materialType     String         @default("DOCUMENT") // DOCUMENT, SLIDES, AUDIO_RECORDING, VIDEO_LINK
  fileUrl          String         @db.Text
  fileName         String         @db.Text
  fileSize         Int?
  mimeType         String?
  durationSeconds  Int?
  isPublished      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model TertiaryAssignment {
  id               String                         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering                 @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  lecturerId       String
  lecturer         StaffProfile                   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  title            String                         @db.Text
  description      String                         @db.Text
  maxScore         Float                          @default(20.0)
  dueDate          DateTime
  assessmentType   String                         @default("ASSIGNMENT") // "ASSIGNMENT" or "ESSAY_EXAM"
  durationMinutes  Int?                           // Live countdown timer in minutes for Essay Exam sessions
  attachmentUrl    String?                        @db.Text
  attachmentName   String?                        @db.Text
  status           String                         @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED
  submissions      TertiaryAssignmentSubmission[]
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
}

model TertiaryAssignmentSubmission {
  id               String             @id @default(uuid())
  assignmentId     String
  assignment       TertiaryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionText   String?            @db.Text
  fileUrl          String?            @db.Text
  fileName         String?            @db.Text
  fileSize         Int?
  status           String             @default("SUBMITTED") // SUBMITTED, GRADED, RESUBMITTED, LATE
  score            Float?
  feedback         String?            @db.Text
  pasteCount       Int                @default(0)
  tabSwitchCount   Int                @default(0)
  isPasteFlagged   Boolean            @default(false)
  similarityScore  Float?             @default(0.0)
  startedAt        DateTime?          // Timestamp when student activates their exam/submission session
  gradedById       String?
  gradedBy         StaffProfile?      @relation("SubmissionGrader", fields: [gradedById], references: [id])
  gradedAt         DateTime?
  submittedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([assignmentId, studentId])
}

// ==============================================================================
// ENTERPRISE PAYMENT VOUCHER & DISBURSEMENT HUB (APPROVAL LIFECYCLE)
// ==============================================================================

model PaymentVoucher {
  id                 String                @id @default(uuid())
  voucherNumber      String                @unique // e.g. PV2026102200001
  voucherClass       String                @default("PAYMENT") // PAYMENT, RECEIPT, JOURNAL
  voucherDate        DateTime              @default(now())
  branchOrCampus     String                @default("Main Campus")
  paymentMethod      String                @default("BANK_TRANSFER") // BANK_TRANSFER, CASH, CHEQUE, ELECTRONIC
  payeeCategory      String                @default("SUPPLIER") // SUPPLIER, STAFF, STUDENT, CONTRACTOR, OTHER
  payeeName          String                @db.Text
  payeeAddress       String?               @db.Text
  payeePhone         String?
  sourceAccountId    String
  sourceAccount      AccountCode           @relation("VoucherSourceAccount", fields: [sourceAccountId], references: [id])
  bankTransferRef    String?
  chequeNumber       String?
  narration          String                @db.Text
  grossAmount        Float                 @default(0.0)
  whtRate            Float                 @default(0.0) // 0%, 5%, 10%
  whtAmount          Float                 @default(0.0)
  netAmount          Float                 @default(0.0)
  status             String                @default("DRAFT") // DRAFT, CHECKED, VERIFIED, APPROVED, POSTED, CANCELLED
  currentStage       String                @default("CREATION") // CREATION, CHECKING, VERIFICATION, APPROVAL, POSTED, CANCELLED

  // Lifecycle Actors & Timestamps
  createdById        String
  createdBy          User                  @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime              @default(now())

  checkedById        String?
  checkedBy          User?                 @relation("VoucherCheckedBy", fields: [checkedById], references: [id])
  checkedAt          DateTime?

  verifiedById       String?
  verifiedBy         User?                 @relation("VoucherVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?

  approvedById       String?
  approvedBy         User?                 @relation("VoucherApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?

  postedById         String?
  postedBy           User?                 @relation("VoucherPostedBy", fields: [postedById], references: [id])
  postedAt           DateTime?

  journalEntryId     String?               @unique
  journalEntry       JournalEntry?         @relation("VoucherJournalEntry", fields: [journalEntryId], references: [id])

  cancelledById      String?
  cancelledBy        User?                 @relation("VoucherCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt        DateTime?
  cancellationReason String?               @db.Text

  updatedAt          DateTime              @default(now()) @updatedAt

  lines              PaymentVoucherLine[]
  auditTrail         PaymentVoucherAudit[]
}

model PaymentVoucherLine {
  id          String         @id @default(uuid())
  voucherId   String
  voucher     PaymentVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId   String
  account     AccountCode    @relation("VoucherLineAccount", fields: [accountId], references: [id])
  description String?        @db.Text
  amount      Float          @default(0.0)
  createdAt   DateTime       @default(now())
}

model PaymentVoucherAudit {
  id          String         @id @default(uuid())
  voucherId   String
  voucher     PaymentVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User           @relation("VoucherAuditActor", fields: [actorId], references: [id])
  fromStatus  String
  toStatus    String
  action      String         // CREATED, EDITED, CHECKED, RETURNED_TO_CREATOR, VERIFIED, RETURNED_TO_CHECKER, APPROVED, POSTED, CANCELLED
  remarks     String?        @db.Text
  createdAt   DateTime       @default(now())
}

// ============================================================================
// NIGERIAN TERTIARY ADMISSIONS, JAMB CAPS & POST-UTME MODELS
// ============================================================================

enum ApplicationMode {
  UTME
  DIRECT_ENTRY
  TRANSFER
}

enum AdmissionStatus {
  APPLIED
  SCREENED
  RECOMMENDED
  PROVISIONALLY_ADMITTED
  OFFER_ACCEPTED
  OFFER_DECLINED
  MATRICULATED
  REJECTED
}

enum ScreeningMethod {
  CBT_EXAM
  CREDENTIAL_AGGREGATE
}

enum OLevelExamBody {
  WAEC
  NECO
  NABTEB
  CAMBRIDGE
}

enum AdmissionQuotaCategory {
  MERIT
  CATCHMENT
  ELDS
  DISCRETIONARY
}

model AdmissionCampaign {
  id                 String              @id @default(uuid())
  academicSessionId  String
  academicSession    AcademicSession     @relation(fields: [academicSessionId], references: [id])
  title              String              // e.g. "2025/2026 Undergraduate Admissions"
  startDate          DateTime
  endDate            DateTime
  applicationFee     Float               @default(2000.0) // Post-UTME statutory fee (N2,000 standard)
  acceptanceFee      Float               @default(50000.0)
  screeningMethod    ScreeningMethod     @default(CREDENTIAL_AGGREGATE)
  isActive           Boolean             @default(true)
  batches            AdmissionBatch[]
  applicants         AdmissionApplicant[]
  cutOffs            DepartmentalCutOff[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model DepartmentalCutOff {
  id                 String              @id @default(uuid())
  campaignId         String
  campaign           AdmissionCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  programId          String
  program            AcademicProgram     @relation(fields: [programId], references: [id])
  minJambScore       Int                 @default(160)
  minCompositeScore  Float               @default(50.0) // e.g. 50.0%
  meritQuota         Int                 @default(50)
  catchmentQuota     Int                 @default(35)
  eldsQuota          Int                 @default(15)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([campaignId, programId])
}

model AdmissionApplicant {
  id                 String              @id @default(uuid())
  campaignId         String
  campaign           AdmissionCampaign   @relation(fields: [campaignId], references: [id])
  applicationNumber  String              @unique // e.g. "PROX/ADM/2025/00142"
  jambRegNumber      String              @unique // e.g. "202410493821AB"
  mode               ApplicationMode     @default(UTME)
  
  // Biodata
  firstName          String
  lastName           String
  otherNames         String?
  email              String
  phone              String
  gender             String
  dateOfBirth        DateTime
  stateOfOrigin      String
  lga                String
  passportPhotoUrl   String?
  
  // Direct Entry Details (If mode is DIRECT_ENTRY)
  deInstitution      String?
  deQualification    String?             // ND, HND, IJMB, JUPEB, NCE
  deGradeOrCgpa      String?             // Distinction, Upper Credit, 12 Points

  // Program Choices
  firstChoiceId      String
  firstChoice        AcademicProgram     @relation("FirstChoiceProgram", fields: [firstChoiceId], references: [id])
  secondChoiceId     String?
  secondChoice       AcademicProgram?    @relation("SecondChoiceProgram", fields: [secondChoiceId], references: [id])
  
  // Scores & Screening
  jambScore          Int                 // Out of 400
  jambSubjects       Json                // [{"subject": "Use of English", "score": 72}, ...]
  postUtmeScore      Float?              // CBT score out of 100 or screening grade
  oLevelAggregate    Float?              // Calculated points from 5 core credits
  compositeScore     Float?              // Weighted aggregate: e.g. (JAMB/8) + (PUTME/2) + OLevel
  
  // Admission & Quota Allocation
  quotaCategory      AdmissionQuotaCategory?
  status             AdmissionStatus     @default(APPLIED)
  admittedProgramId  String?
  admittedProgram    AcademicProgram?    @relation("AdmittedProgram", fields: [admittedProgramId], references: [id])
  batchId            String?
  batch              AdmissionBatch?     @relation(fields: [batchId], references: [id])
  
  // JAMB CAPS Sync
  jambCapsStatus     String?             @default("PENDING_RECOMMENDATION") // PENDING_RECOMMENDATION, RECOMMENDED_TO_JAMB, APPROVED_BY_JAMB, ACCEPTED_BY_CANDIDATE
  jambAdmissionLetterUrl String?
  
  // Financial Records
  applicationFeePaid Boolean             @default(false)
  acceptanceFeePaid  Boolean             @default(false)
  
  // Relations
  oLevelResults      ApplicantOLevel[]
  screeningSchedule  ScreeningSchedule?
  offerLetter        AdmissionOffer?
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ApplicantOLevel {
  id                 String              @id @default(uuid())
  applicantId        String
  applicant          AdmissionApplicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  examBody           OLevelExamBody
  examYear           Int
  examCenterNumber   String
  candidateNumber    String
  scratchCardPin     String?             // For automated WAEC/NECO API verification
  scratchCardSerial  String?
  isVerified         Boolean             @default(false)
  grades             Json                // [{"subject": "English Language", "grade": "B2", "points": 7}, ...]
  resultSlipUrl      String?
  sittingNumber      Int                 @default(1) // 1 or 2
  createdAt          DateTime            @default(now())
}

model ScreeningSchedule {
  id                 String              @id @default(uuid())
  applicantId        String              @unique
  applicant          AdmissionApplicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  venue              String
  examDate           DateTime
  batchTime          String              // e.g. "08:30 AM"
  seatNumber         String
  attendanceStatus   Boolean             @default(false)
  createdAt          DateTime            @default(now())
}

model AdmissionBatch {
  id                 String              @id @default(uuid())
  campaignId         String
  campaign           AdmissionCampaign   @relation(fields: [campaignId], references: [id])
  batchName          String              // e.g. "First Batch Merit", "Supplementary Batch", "Direct Entry Batch"
  batchNumber        Int                 @default(1)
  isPublished        Boolean             @default(false)
  publishedAt        DateTime?
  applicants         AdmissionApplicant[]
  offers             AdmissionOffer[]
  createdAt          DateTime            @default(now())
}

model AdmissionOffer {
  id                 String              @id @default(uuid())
  applicantId        String              @unique
  applicant          AdmissionApplicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  batchId            String
  batch              AdmissionBatch      @relation(fields: [batchId], references: [id])
  provisionalLetterCode String           @unique // Cryptographic Verification Token
  acceptanceDeadline DateTime
  isAccepted         Boolean             @default(false)
  acceptedAt         DateTime?
  matricNumberAssigned String?           @unique
  studentProfileId   String?             @unique
  createdAt          DateTime            @default(now())
}

// ==========================================
// HOSTEL & BEDSPACE ALLOCATION ENGINE
// ==========================================

model Hostel {
  id                 String             @id @default(uuid())
  name               String             // e.g. "Prof. Kenneth Dike Hall", "Queen Moremi Hall"
  code               String             @unique // e.g. "HL-DIKE", "HL-MOREMI"
  campusId           String?
  campus             Campus?            @relation(fields: [campusId], references: [id], onDelete: SetNull)
  gender             String             @default("MIXED") // "MALE" | "FEMALE" | "MIXED"
  category           String             @default("UNDERGRADUATE") // "UNDERGRADUATE" | "POSTGRADUATE" | "BASIC_BOARDING"
  description        String?            @db.Text
  wardenName         String?
  wardenPhone        String?
  wardenEmail        String?
  status             String             @default("ACTIVE") // "ACTIVE" | "MAINTENANCE" | "DECOMMISSIONED"
  blocks             HostelBlock[]
  rooms              HostelRoom[]
  allocations        HostelAllocation[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model HostelBlock {
  id                 String             @id @default(uuid())
  hostelId           String
  hostel             Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  name               String             // e.g. "Block A", "Wing 1"
  floors             Int                @default(1)
  rooms              HostelRoom[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model HostelRoom {
  id                 String             @id @default(uuid())
  hostelId           String
  hostel             Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  blockId            String?
  block              HostelBlock?       @relation(fields: [blockId], references: [id], onDelete: SetNull)
  roomNumber         String             // e.g. "A101", "B204"
  floor              Int                @default(0) // 0 = Ground Floor, 1 = First Floor
  capacity           Int                @default(4)
  feePerSession      Float              @default(0)
  type               String             @default("STANDARD") // "STANDARD", "EXECUTIVE", "ENSUITE", "SPECIAL_NEEDS"
  status             String             @default("AVAILABLE") // "AVAILABLE", "FULL", "MAINTENANCE"
  bedSpaces          HostelBedSpace[]
  allocations        HostelAllocation[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([hostelId, roomNumber])
}

model HostelBedSpace {
  id                 String             @id @default(uuid())
  roomId             String
  room               HostelRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber          String             // e.g. "Bed 1 (Lower Bunk)", "Bed 2 (Upper Bunk)"
  isOccupied         Boolean            @default(false)
  status             String             @default("AVAILABLE") // "AVAILABLE", "RESERVED", "OCCUPIED", "MAINTENANCE"
  allocations        HostelAllocation[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([roomId, bedNumber])
}

model HostelAllocation {
  id                 String             @id @default(uuid())
  allocationRef      String             @unique // e.g. "HA-2026-98124"
  academicSessionId  String?
  academicSession    AcademicSession?   @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  hostelId           String
  hostel             Hostel             @relation(fields: [hostelId], references: [id])
  roomId             String
  room               HostelRoom         @relation(fields: [roomId], references: [id])
  bedSpaceId         String
  bedSpace           HostelBedSpace     @relation(fields: [bedSpaceId], references: [id])
  studentProfileId   String?
  studentProfile     StudentProfile?    @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)
  studentId          String?
  student            Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  status             String             @default("ALLOCATED") // "ALLOCATED", "CHECKED_IN", "CHECKED_OUT", "CANCELLED", "REVOKED"
  allocatedAt        DateTime           @default(now())
  expiresAt          DateTime?
  checkedInAt        DateTime?
  checkedInBy        String?
  checkedOutAt       DateTime?
  checkedOutBy       String?
  keyTag             String?
  inventoryNotes     String?            @db.Text
  clearanceNotes     String?            @db.Text
  qrToken            String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// ==========================================
// ONLINE STUDENT PAYMENTS & GATEWAY AUDIT
// ==========================================

model OnlinePaymentLog {
  id               String    @id @default(uuid())
  reference        String    @unique // e.g. "PRX-PAY-2026-98124"
  rrrCode          String?   // Remita Retrieval Reference (12 digits)
  gateway          String    // "PAYSTACK" | "REMITA" | "MONNIFY" | "FLUTTERWAVE" | "BANK_TRANSFER"
  amount           Float
  currency         String    @default("NGN")
  status           String    @default("PENDING") // "PENDING", "SUCCESS", "FAILED", "ABANDONED"
  channel          String?   // "card", "bank_transfer", "ussd", "rrr_bank_branch", "virtual_account"
  invoiceType      String    @default("TERTIARY") // "TERTIARY" | "SECONDARY"
  invoiceId        String
  studentId        String?
  payerEmail       String?
  payerName        String?
  payerPhone       String?
  gatewayPayload   String?   @db.LongText
  paidAt           DateTime?
  bursaryCleared   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([reference])
  @@index([rrrCode])
  @@index([invoiceId])
}

// --- PARENT SCHOOL WALLET & ADVANCE TUITION FUNDING ---

model ParentWallet {
  id            String              @id @default(cuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float               @default(0.0)
  accountNumber String?             // Assigned Betastack/Zainpay DVA for direct wallet funding
  bankName      String?             @default("Guaranty Trust Bank (GTBank Virtual Collection)")
  currency      String              @default("NGN")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  transactions  WalletTransaction[]
}

model WalletTransaction {
  id          String        @id @default(cuid())
  walletId    String
  wallet      ParentWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String        // CREDIT (Fund Wallet) or DEBIT (Fee Payment)
  category    String        // WALLET_FUNDING, TUITION_PAYMENT, REFUND, ADJUSTMENT
  description String
  reference   String        @unique
  status      String        @default("SUCCESS") // SUCCESS, PENDING, FAILED
  invoiceId   String?
  metadata    String?       // JSON metadata
  createdAt   DateTime      @default(now())
}

// ==============================================================================
// ACADEMIC JOURNAL PUBLISHING & RESEARCH REPOSITORY MODULE
// ==============================================================================

model AcademicJournal {
  id              String           @id @default(uuid())
  title           String
  code            String           @unique // e.g. "PJSC"
  issn            String?          // Print ISSN (e.g. "2345-6789")
  eIssn           String?          // Electronic ISSN
  description     String?          @db.Text
  scopeAndAim     String?          @db.Text
  faculty         String?          // e.g. "Faculty of Science & Computing"
  department      String?          // e.g. "Computer Science"
  editorInChief   String?          // e.g. "Prof. Ibrahim Danbatta"
  coverUrl        String?
  status          String           @default("ACTIVE") // ACTIVE, ARCHIVED
  issues          JournalIssue[]
  articles        JournalArticle[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([code])
}

model JournalIssue {
  id              String           @id @default(uuid())
  journalId       String
  journal         AcademicJournal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  volume          Int
  issueNumber     Int
  title           String?          // e.g. "Vol. 4 No. 2 (2026): Contemporary Paradigms in Computing"
  publicationDate DateTime?
  coverUrl        String?
  status          String           @default("PUBLISHED") // DRAFT, IN_PRESS, PUBLISHED
  articles        JournalArticle[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([journalId, volume, issueNumber])
  @@index([journalId])
}

model JournalArticle {
  id              String              @id @default(uuid())
  journalId       String
  journal         AcademicJournal     @relation(fields: [journalId], references: [id], onDelete: Cascade)
  issueId         String?
  issue           JournalIssue?       @relation(fields: [issueId], references: [id], onDelete: SetNull)
  title           String              @db.Text
  abstract        String              @db.LongText
  keywords        String?             // e.g. "Machine Learning, Distributed Systems, Cloud Computing"
  authors         String              @db.Text // JSON or formatted string of authors with affiliations & ORCIDs
  primaryAuthorId String?             // Optional link to User profile
  doi             String?             // e.g. "10.1234/pjsc.2026.4.2.01"
  manuscriptUrl   String?             // Original submission file
  publishedPdfUrl String?             // Final publication galley PDF
  pages           String?             // e.g. "45-58"
  citationsCount  Int                 @default(0)
  downloadsCount  Int                 @default(0)
  viewsCount      Int                 @default(0)
  status          String              @default("PUBLISHED") // SUBMITTED, UNDER_PEER_REVIEW, REVISION_REQUESTED, ACCEPTED, REJECTED, PUBLISHED
  peerReviews     JournalPeerReview[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([journalId])
  @@index([issueId])
  @@index([status])
}

model JournalPeerReview {
  id                   String         @id @default(uuid())
  articleId            String
  article              JournalArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewerId           String?
  reviewerName         String?
  reviewerEmail        String?
  blindType            String         @default("DOUBLE_BLIND") // DOUBLE_BLIND, SINGLE_BLIND, OPEN
  originalityScore     Int?           // 1 to 5
  methodologyScore     Int?           // 1 to 5
  clarityScore         Int?           // 1 to 5
  significanceScore    Int?           // 1 to 5
  recommendation       String?        // ACCEPT, MINOR_REVISION, MAJOR_REVISION, REJECT
  confidentialComments String?        @db.Text
  authorComments       String?        @db.Text
  status               String         @default("PENDING") // PENDING, COMPLETED
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([articleId])
}

// ==============================================================================
// UNIVERSITY INFORMATION BULLETINS & GAZETTES MODULE
// ==============================================================================

model UniversityBulletin {
  id              String    @id @default(uuid())
  title           String
  bulletinType    String    @default("OFFICIAL_BULLETIN") // OFFICIAL_BULLETIN, SENATE_COMMUNIQUE, SPECIAL_DIGEST, EMERGENCY_NOTICE, RESEARCH_BRIEF
  volume          Int       @default(1)
  issueNumber     Int       @default(1)
  publicationDate DateTime  @default(now())
  publishedBy     String    @default("Directorate of Information & Protocol (DIPR)")
  editorInChief   String?   @default("University Registrar")
  summary         String?   @db.Text
  content         String?   @db.LongText
  pdfUrl          String?
  coverUrl        String?
  targetAudience  String    @default("ALL") // ALL, STAFF_ONLY, STUDENTS_ONLY, FACULTY_ONLY
  isUrgent        Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  viewCount       Int       @default(0)
  status          String    @default("PUBLISHED") // DRAFT, UNDER_REVIEW, APPROVED, PUBLISHED, ARCHIVED
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bulletinType])
  @@index([status])
  @@index([publicationDate])
}
